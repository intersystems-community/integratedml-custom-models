{
  "_comment": "Generate the repos first (delete old ones; the generator refuses to overwrite): python -m agent_controller.live.make_task_repo ~/ccruns/bugs-a --seed 1  (and bugs-b --seed 2). Each task is 4 prompts in one session; the compact conditions run /compact between phases.",
  "tasks": [
    {
      "name": "bugs-a",
      "repo": "~/ccruns/bugs-a",
      "ref": "HEAD",
      "check": "python3 check.py ~/ccruns/bugs-a.bugs.json",
      "timeout_minutes": 45,
      "prompt_files": [
        "PROMPT.md",
        "PHASE2.md",
        "PHASE3.md",
        "PHASE4.md"
      ]
    },
    {
      "name": "bugs-b",
      "repo": "~/ccruns/bugs-b",
      "ref": "HEAD",
      "check": "python3 check.py ~/ccruns/bugs-b.bugs.json",
      "timeout_minutes": 45,
      "prompt_files": [
        "PROMPT.md",
        "PHASE2.md",
        "PHASE3.md",
        "PHASE4.md"
      ]
    }
  ],
  "conditions": {
    "default": {},
    "compact-each-phase": {
      "compact_each_phase": true
    },
    "compact-each-phase+keeplist": {
      "compact_each_phase": true,
      "keeplist": true
    }
  }
}
