# Custom IRIS Dockerfile with IntegratedML support
FROM intersystemsdc/iris-community:latest

USER root

# Install system dependencies needed for Python packages
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-dev \
    gcc \
    g++ \
    make \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Install IntegratedML Python dependencies (use latest compatible versions)
RUN pip3 install --no-cache-dir \
    scikit-learn \
    pandas \
    numpy \
    scipy \
    joblib \
    matplotlib \
    seaborn \
    xgboost \
    lightgbm

# Install IntegratedML AutoML package from InterSystems registry
RUN python3 -m pip install --index-url https://registry.intersystems.com/pypi/simple \
    --no-cache-dir \
    --target /usr/irissys/mgr/python \
    intersystems-iris-automl

# Install basic AutoML dependencies
RUN pip3 install --no-cache-dir \
    optuna \
    catboost

# Install additional ML packages that work with IntegratedML
RUN pip3 install --no-cache-dir \
    mlxtend \
    imbalanced-learn

# Verify installation
RUN python3 -c "import sklearn; print(f'scikit-learn version: {sklearn.__version__}')" && \
    python3 -c "import pandas; print(f'pandas version: {pandas.__version__}')" && \
    python3 -c "import numpy; print(f'numpy version: {numpy.__version__}')" && \
    python3 -c "import xgboost; print(f'xgboost version: {xgboost.__version__}')" && \
    echo "All IntegratedML packages installed successfully!"

# Copy initialization scripts
COPY docker/iris-init/ /opt/irisapp/init/

# Make sure initialization scripts are executable
RUN chmod +x /opt/irisapp/init/*.sh

# Create directories for custom models
RUN mkdir -p /opt/iris/mgr/python/custom_models/classifiers \
    && mkdir -p /opt/iris/mgr/python/custom_models/regressors

# Copy custom Python models from demos
COPY demos/ /tmp/demos/

# Copy all custom models to the IRIS Python path
RUN cp -r /tmp/demos/*/models/*.py /opt/iris/mgr/python/custom_models/classifiers/ 2>/dev/null || true \
    && cp -r /tmp/demos/*/models/*.py /opt/iris/mgr/python/custom_models/regressors/ 2>/dev/null || true \
    && rm -rf /tmp/demos

USER irisowner

# Run the standard IRIS entrypoint
ENTRYPOINT ["/tini", "--", "/docker-entrypoint.sh"]