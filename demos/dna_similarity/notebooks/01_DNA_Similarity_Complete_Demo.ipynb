  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## IntegratedML Evaluation and Metrics\n\nThis section runs `VALIDATE MODEL` and `EVALUATE MODEL` for the demo model and then queries `information_schema` to display metrics."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "tags": [
     "integratedml",
     "evaluation"
    ]
   },
   "execution_count": null,
   "outputs": [],
   "source": [
    "# IntegratedML connection helper (uses env: IRIS_HOST, IRIS_PORT, IRIS_USERNAME, IRIS_PASSWORD, IRIS_NAMESPACE)\nfrom shared.database.connection import IRISConnection\nimport pandas as pd\nconn = IRISConnection()\ndef sql_df(q: str) -> pd.DataFrame:\n    rows = conn.execute_sql(q)\n    try:\n        return pd.DataFrame(rows)\n    except Exception:\n        return pd.DataFrame(rows)\nmodel_name = \"DNASimilarityModel\"\nprint(f\"Using model: {model_name} in namespace {conn.namespace} at {conn.host}:{conn.port}\")\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "tags": [
     "integratedml",
     "evaluation"
    ]
   },
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Run validation to ensure metrics are computed and stored\n_ = conn.execute_sql(f\"VALIDATE MODEL {model_name}\")\nprint(\"Validation complete (see information_schema.ML_VALIDATION_METRICS).\")\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "tags": [
     "integratedml",
     "evaluation"
    ]
   },
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Run VALIDATE to compute/store metrics, then EVALUATE (non-SELECT command)\n_ = conn.execute_sql(f\"EVALUATE MODEL {model_name}\")\n# Always read stored metrics (portable across versions)\nval_metrics = sql_df(f\"SELECT model_name, metric_name, metric_value FROM information_schema.ML_VALIDATION_METRICS WHERE model_name = '{model_name}' ORDER BY metric_name\")\nif not val_metrics.empty:\n    display(val_metrics)\n# If ML_EVALUATION_METRICS exists, show it\ntry:\n    eval_metrics = sql_df(f\"SELECT model_name, metric_name, metric_value FROM information_schema.ML_EVALUATION_METRICS WHERE model_name = '{model_name}' ORDER BY metric_name\")\n    if not eval_metrics.empty:\n        display(eval_metrics)\nexcept Exception as e:\n    print(\"ML_EVALUATION_METRICS view not available on this version:\", e)\n"
   ]
  }
