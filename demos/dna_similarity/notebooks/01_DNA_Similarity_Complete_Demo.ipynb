  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Title and Objective\n",
    "\n",
    "This notebook demonstrates a complete workflow for DNA similarity analysis using IntegratedML. The objective is to load DNA sequences, compute a similarity matrix, and visualize the results."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Environment Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import sys\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import yaml\n",
    "\n",
    "# Set display options\n",
    "pd.set_option('display.max_rows', 500)\n",
    "pd.set_option('display.max_columns', 500)\n",
    "pd.set_option('display.width', 1000)\n",
    "plt.style.use('ggplot')\n",
    "np.random.seed(42)\n",
    "\n",
    "# Construct project_root\n",
    "def find_project_root(start_path, marker='shared'):\n",
    "    path = os.path.abspath(start_path)\n",
    "    while True:\n",
    "        if marker in os.listdir(path):\n",
    "            return path\n",
    "        parent_path = os.path.dirname(path)\n",
    "        if parent_path == path:\n",
    "            raise FileNotFoundError(f\"Could not find project root with marker '{marker}'\")\n",
    "        path = parent_path\n",
    "\n",
    "try:\n",
    "    project_root = find_project_root(os.getcwd())\n",
    "    if project_root not in sys.path:\n",
    "        sys.path.append(project_root)\n",
    "except FileNotFoundError as e:\n",
    "    print(e)\n",
    "\n",
    "from shared.database.connection import get_connection, test_connection\n",
    "from shared.database.data_loader import DataLoader\n",
    "from shared.database.model_manager import ModelManager\n",
    "from shared.utils.logging import logger\n",
    "from notebooks.utils.plotting import plot_similarity_heatmap, plot_sequence_alignment"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Load Config"
