  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "config_path = os.path.join(project_root, 'demos', 'dna_similarity', 'config', 'dna_model_config.yaml')\n",
    "try:\n",
    "    with open(config_path, 'r') as f:\n",
    "        config = yaml.safe_load(f)\n",
    "    logger.info(\"DNA model config loaded successfully.\")\n",
    "    # print(config)\n",
    "except FileNotFoundError:\n",
    "    logger.error(f\"Config file not found at {config_path}\")\n",
    "    config = {}\\n\\n# Robust project root detection (works regardless of execution cwd)\n",
    "def find_project_root(start_path, marker=shared):\n",
    "    path = os.path.abspath(start_path)\n",
    "    while True:\n",
    "        if os.path.isdir(os.path.join(path, marker)):\n",
    "            return path\n",
    "        parent_path = os.path.dirname(path)\n",
    "        if parent_path == path:\n",
    "            return start_path\n",
    "        path = parent_path\n",
    "\n",
    "project_root = find_project_root(os.getcwd())\n",
    "if project_root not in sys.path:\n",
    "    sys.path.append(project_root)\\n"
   ]
